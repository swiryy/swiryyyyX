+/** Lightweight event inbox: group + sender + reply text. No full-history search. */
+public final class SviriMentionsController extends RecyclerViewController<Void> implements MessageListener, TdlibSettingsManager.HiddenChatsListener {
+  private final long userId;
+  private final List<MentionInboxStore.Entry> rows = new ArrayList<>();
+  private final ArrayDeque<Long> pending = new ArrayDeque<>();
+  private final HashSet<Long> queued = new HashSet<>();
+  private final Runnable inboxChanged=()->UI.post(this::requestReload);
+  private Adapter adapter;
+  private boolean unreadOnly,reloadQueued;
+  private final List<AvatarView> avatars=new ArrayList<>();
+  private boolean discovering, requesting;
+  private int discoveries, generation;
+  private String error;
+  public SviriMentionsController(Context context,Tdlib tdlib) { super(context,tdlib);userId=tdlib.myUserId(); }
+  @Override public int getId() { return R.id.controller_sviriMentions; }
+  @Override public CharSequence getName() { return Lang.getString(R.string.SviriMentions); }
+  private boolean current() { return !isDestroyed() && userId==tdlib.myUserId(); }
+  @Override protected void onCreateView(Context context,CustomRecyclerView recycler) {
+    recycler.setLayoutManager(new LinearLayoutManager(context));recycler.setItemAnimator(null);
+    recycler.setPadding(Screen.dp(12),Screen.dp(8),Screen.dp(12),Screen.dp(16));
+    adapter=new Adapter();recycler.setAdapter(adapter);
+    tdlib.listeners().subscribeForGlobalUpdates(this);tdlib.settings().addHiddenChatsListener(this);tdlib.settings().mentionInbox().addListener(inboxChanged);reload();
+  }
+  private void reload() {
+    if(!current()||adapter==null)return;
+    rows.clear();
+    for(MentionInboxStore.Entry e:tdlib.settings().mentionInbox().snapshot()) {
+      TdApi.User author=e.senderUserId>0?tdlib.cache().user(e.senderUserId):null;
+      boolean human=MentionInboxPolicy.humanPersonal(e)||(e.senderUserId>0&&e.authorType==0&&e.relation==3&&!e.viaBot&&author!=null&&author.type instanceof TdApi.UserTypeRegular);
+      if(human&&(!unreadOnly||!e.seen)&&!tdlib.settings().isChatHidden(e.chatId)&&!tdlib.settings().isMentionSenderIgnored(e.senderUserId))rows.add(e);
+    }
+    adapter.notifyDataSetChanged();
+  }
+  private void refreshUnread() {
+    if(!current()||discovering||requesting||!pending.isEmpty())return;
+    error=null;queued.clear();discovering=true;discoveries=2;final int token=++generation;reload();
