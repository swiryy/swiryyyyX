@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import org.drinkless.tdlib.TdApi;
+
+/** Use the received gift's actual conversion value and server upgrade eligibility. */
+public final class GiftManagePolicy {
+  private GiftManagePolicy() { }
+  private static boolean regular(TdApi.ReceivedGift gift) {
+    return gift != null && gift.receivedGiftId != null && !gift.receivedGiftId.isEmpty()
+      && !gift.wasRefunded && gift.gift instanceof TdApi.SentGiftRegular
+      && ((TdApi.SentGiftRegular)gift.gift).gift != null;
+  }
+  /** -1 is unavailable; prepaid upgrades cost the owner zero Stars. */
+  public static long upgradeCost(TdApi.ReceivedGift gift) {
+    if (!regular(gift) || !gift.canBeUpgraded) return -1;
+    if (gift.prepaidUpgradeStarCount > 0) return 0;
+    long cost = ((TdApi.SentGiftRegular)gift.gift).gift.upgradeStarCount;
+    return cost > 0 ? cost : -1;
+  }
+  /** Never substitute catalog/default values for the owner's actual conversion quote. */
+  public static long conversionValue(TdApi.ReceivedGift gift) {
+    return regular(gift) && gift.sellStarCount > 0 ? gift.sellStarCount : -1;
+  }
+}
