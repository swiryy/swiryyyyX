+      else if (current()) toast((result instanceof TdApi.Error ? TD.toErrorString(result) : Lang.getString(R.string.SviriUnexpectedResponse)) + "\n" + Lang.getString(R.string.SviriGiftCheckBeforeRetry));
+    })) fail(new TdApi.Error(400, Lang.getString(R.string.SviriGiftBusy)));
+  }
