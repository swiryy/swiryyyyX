+  private void restorePriorityChats (long[] ids, int offset, int generation) {
+    if (generation != priorityWarmupGeneration || !isAuthorized() || offset >= ids.length) return;
+    int end = Math.min(offset + 16, ids.length);
+    java.util.concurrent.atomic.AtomicInteger remaining = new java.util.concurrent.atomic.AtomicInteger(end - offset);
+    for (int i = offset; i < end; i++) {
+      // GetChat reads TDLib's local chat database; it does not download histories.
+      send(new TdApi.GetChat(ids[i]), (chat, error) -> {
+        if (remaining.decrementAndGet() == 0) {
+          restorePriorityChats(ids, end, generation);
+        }
+      });
+    }
+  }
+
+  private void discoverPriorityChats (TdlibChatList list, int generation, int pagesLeft) {
+    if (pagesLeft <= 0 || generation != priorityWarmupGeneration || !isAuthorized() || list.isEndReached()) return;
+    int before = list.count(null);
+    list.loadMore(50, () -> {
+      if (pagesLeft <= 0 || generation != priorityWarmupGeneration || !isAuthorized() || list.isEndReached()) return;
+      // Yield between metadata pages; retry backoff still belongs to the source list.
+      double delay = list.count(null) > before ? .15 : 2.0;
+      runOnTdlibThread(() -> discoverPriorityChats(list, generation, pagesLeft - 1), delay, false);
+    });
+  }
