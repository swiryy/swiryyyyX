@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import org.drinkless.tdlib.TdApi;
+
+/** A reviewed static copy for folders whose automatic filters Telegram cannot share. */
+public final class FolderTransferPlan {
+  private FolderTransferPlan() { }
+  public static boolean needsCopy(TdApi.ChatFolder f) {
+    return f.includeContacts || f.includeNonContacts || f.includeBots || f.includeGroups || f.includeChannels ||
+      f.excludeMuted || f.excludeRead || f.excludeArchived || f.excludedChatIds != null && f.excludedChatIds.length != 0;
+  }
+  public static long[] part(long[] ids, int limit, int part) {
+    if (limit <= 0 || part < 0) throw new IllegalArgumentException("Invalid folder limit or part");
+    LinkedHashSet<Long> unique = new LinkedHashSet<>();
+    for (long id : ids) if (id != 0) unique.add(id);
+    long[] all = unique.stream().mapToLong(Long::longValue).toArray();
+    long offset = (long) limit * part;
+    if (offset >= all.length) return new long[0];
+    return Arrays.copyOfRange(all, (int) offset, (int) Math.min(all.length, offset + limit));
+  }
+  public static TdApi.ChatFolder copy(TdApi.ChatFolderInfo source, long[] ids, int part) {
+    if (ids.length == 0) throw new IllegalArgumentException("Empty copy");
+    TdApi.ChatFolder f = new TdApi.ChatFolder();
+    f.name = new TdApi.ChatFolderName(new TdApi.FormattedText("Перенос " + (part + 1), new TdApi.TextEntity[0]), false);
+    f.icon = source.icon; f.colorId = -1;
+    f.pinnedChatIds = new long[0]; f.includedChatIds = ids.clone(); f.excludedChatIds = new long[0];
+    return f;
+  }
+}
