@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.ui;
+
+import android.app.AlertDialog;
+import android.widget.CheckBox;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+import java.util.function.Consumer;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.data.TD;
+import org.thunderdog.challegram.navigation.ViewController;
+import org.thunderdog.challegram.telegram.GiftManagePolicy;
+import org.thunderdog.challegram.telegram.GiftPaymentTask;
+import org.thunderdog.challegram.telegram.GiftSendPolicy;
+import org.thunderdog.challegram.telegram.Tdlib;
+import org.thunderdog.challegram.tool.Screen;
+import org.thunderdog.challegram.tool.UI;
+
+/** Explicitly quoted regular-gift upgrade/conversion. No write is retried automatically. */
+final class SviriGiftManageFlow {
+  private final ViewController<?> owner;
+  private final Tdlib tdlib;
+  private final Runnable changed;
+  private final long userId;
+  private boolean busy, closed, writing, upgrade, keepDetails = true;
+  private int generation;
+  private String receivedId;
+  private AlertDialog dialog;
+  SviriGiftManageFlow(ViewController<?> owner, Tdlib tdlib, Runnable changed) {
+    this.owner = owner; this.tdlib = tdlib; this.changed = changed; userId = tdlib.myUserId();
+  }
+  private boolean current() { return !closed && userId == tdlib.myUserId(); }
+  void destroy() { closed = true; generation++; if (dialog != null) dialog.dismiss(); }
+  private void toast(String value) { UI.showToast(value, Toast.LENGTH_LONG); }
+  private void cancel() { if (!writing) { busy = false; generation++; } }
+  private void fail(TdApi.Object result) {
+    busy = false; generation++;
+    if (current()) toast(result instanceof TdApi.Error ? TD.toErrorString(result) : Lang.getString(R.string.SviriGiftReadFailed));
+  }
+  private void read(TdApi.Function<?> request, Consumer<TdApi.Object> callback) {
+    final int token = generation;
+    Runnable timeout = () -> { if (current() && token == generation) fail(null); };
+    UI.post(timeout, 30000L);
+    tdlib.client().send(request, result -> UI.post(() -> {
+      UI.removePendingRunnable(timeout);
+      if (current() && token == generation) callback.accept(result);
+    }));
+  }
+  void start(TdApi.ReceivedGift gift, boolean upgrade) {
+    if (!current() || busy || gift == null || gift.receivedGiftId == null || gift.receivedGiftId.isEmpty()) return;
+    this.upgrade = upgrade; this.receivedId = gift.receivedGiftId;
+    keepDetails = true; busy = true; generation++; inspect(null);
+  }
+  private static final class Quote {
+    final long giftId, price;
+    final String title;
+    Quote(long giftId, long price, String title) { this.giftId = giftId; this.price = price; this.title = title; }
+  }
+  private void inspect(Quote approved) {
+    read(new TdApi.GetReceivedGift(receivedId), result -> {
+      if (!(result instanceof TdApi.ReceivedGift)) { fail(result); return; }
+      TdApi.ReceivedGift fresh = (TdApi.ReceivedGift)result;
+      long price = upgrade ? GiftManagePolicy.upgradeCost(fresh) : GiftManagePolicy.conversionValue(fresh);
+      if (!receivedId.equals(fresh.receivedGiftId) || price < 0) { fail(new TdApi.Error(400, Lang.getString(R.string.SviriGiftUnavailable))); return; }
+      long giftId = ((TdApi.SentGiftRegular)fresh.gift).gift.id;
+      TdApi.Sticker sticker = ((TdApi.SentGiftRegular)fresh.gift).gift.sticker;
+      Quote quote = new Quote(giftId, price, (sticker != null && sticker.emoji != null ? sticker.emoji + " · " : "") + Lang.getString(R.string.SviriReceivedGift));
+      Runnable ready = () -> {
+        if (approved != null && approved.giftId == giftId && approved.price == price) { write(price); return; }
+        if (approved != null) toast(Lang.getString(R.string.SviriGiftPriceChanged));
+        confirm(quote);
+      };
+      if (upgrade && price > 0) read(new TdApi.GetStarTransactions(new TdApi.MessageSenderUser(userId), "", null, "", 1), balance -> {
+        if (!(balance instanceof TdApi.StarTransactions)) { fail(balance); return; }
+        if (!GiftSendPolicy.enoughStars(((TdApi.StarTransactions)balance).starAmount, price)) {
+          fail(new TdApi.Error(400, Lang.getString(R.string.SviriGiftInsufficient, price))); return;
+        }
+        ready.run();
+      }); else ready.run();
+    });
+  }
+  private void confirm(Quote quote) {
+    LinearLayout content = new LinearLayout(owner.context()); content.setOrientation(LinearLayout.VERTICAL);
+    TextView info = new TextView(owner.context());
+    info.setPadding(Screen.dp(24), Screen.dp(12), Screen.dp(24), Screen.dp(12));
+    info.setText(quote.title + "\n\n" + (upgrade
+      ? Lang.getString(R.string.SviriGiftUpgradeInfo, quote.price)
+      : Lang.getString(R.string.SviriGiftConvertInfo, quote.price))); content.addView(info);
+    CheckBox keep = new CheckBox(owner.context()); keep.setText(R.string.SviriGiftKeepDetails); keep.setChecked(keepDetails);
+    if (upgrade) content.addView(keep);
+    final boolean[] used = {false};
+    dialog = new AlertDialog.Builder(owner.context()).setTitle(upgrade ? R.string.SviriGiftUpgradeShort : R.string.SviriGiftConvertShort)
+      .setView(content).setNegativeButton(R.string.Cancel, (d,w) -> cancel())
+      .setPositiveButton(Lang.getString(upgrade ? R.string.SviriGiftUpgradeConfirm : R.string.SviriGiftConvertConfirm, quote.price), (d,w) -> {
+        if (!current() || used[0] || writing) return;
+        used[0] = true; keepDetails = keep.isChecked(); inspect(quote);
+      }).create();
+    dialog.setOnCancelListener(d -> cancel()); dialog.show();
+  }
+  private void write(long price) {
+    if (!current() || writing) return;
+    writing = true;
+    TdApi.Function<?> request = upgrade ? new TdApi.UpgradeGift("", receivedId, keepDetails, price) : new TdApi.SellGift("", receivedId);
+    if (!GiftPaymentTask.send(tdlib, request, result -> {
+      writing = false; busy = false; generation++;
+      if (!current()) return;
+      boolean success = upgrade ? result instanceof TdApi.UpgradeGiftResult : result instanceof TdApi.Ok;
+      if (success) { toast(Lang.getString(upgrade ? R.string.SviriGiftUpgraded : R.string.SviriGiftConverted)); changed.run(); }
+      else toast((result instanceof TdApi.Error ? TD.toErrorString(result) : Lang.getString(R.string.SviriUnexpectedResponse)) + "\n" + Lang.getString(R.string.SviriGiftCheckBeforeRetry));
+    })) { writing = false; fail(new TdApi.Error(400, Lang.getString(R.string.SviriGiftBusy))); }
+  }
+}
