+"""Execute the actual tab mutation/measurement methods with a minimal view harness."""
+from pathlib import Path
+import subprocess,tempfile
+root=Path(__file__).resolve().parents[2]
+source=(root/'app/src/main/java/org/thunderdog/challegram/navigation/ViewPagerTopView.java').read_text()
+def method(signature):
+ a=source.index(signature);start=source.index('{',a);depth=1;b=start+1
+ while depth:
+  if source[b]=='{':depth+=1
+  elif source[b]=='}':depth-=1
+  b+=1
+ return source[a:b]
+methods='\n'.join(method(s) for s in ['  public void addItemAtIndex (Item item, int index)', '  public void removeItemAt (int index)', '  private void updateWidthMetrics (int totalWidth)', '  private void relayout ()', '  private int calculateTotalWidth ()', '  private int calculateMaxStableWidth (int totalWidth)', '  private int calculateCommonItemWidth (int parentWidth)', '  protected void onMeasure (int widthMeasureSpec, int heightMeasureSpec)'])
+java='''import java.util.*;
+class Base { int measuredWidth; protected void onMeasure(int w,int h){measuredWidth=w;} int getMeasuredWidth(){return measuredWidth;} }
+public class TabWidthTest extends Base {
+static class Item { int width,collapsed; Item(int w){width=w;collapsed=w/2;} int getCollapsedWidth(){return collapsed;} int getExpandedWidth(){return width;} }
+static class TextPaint{} static class MeasureSpec{static final int EXACTLY=1;static int makeMeasureSpec(int w,int m){return w;}}
+List<Item> items=new ArrayList<>(); int itemPadding=0,totalWidth,maxStableWidth,maxItemWidth,lastMeasuredWidth,commonItemWidth;float selectionFactor;
+boolean showLabelOnActiveOnly,fitsParentWidth;int children,requests;boolean wrap=true;
+void requestLayout(){requests++;} void invalidate(){} void onUpdateItems(){} TextPaint getItemTextPaint(Item i){return new TextPaint();}void measureItem(Item i,TextPaint p){}
+void addView(Object v){children++;}Object newBackgroundView(int i){return new Object();}void removeViewAt(int i){if(i<0)throw new AssertionError();children--;}int getChildCount(){return children;}
+boolean shouldWrapContent(){return wrap;}void layout(int w,boolean wrap){if(w>0&&!items.isEmpty())commonItemWidth=calculateCommonItemWidth(w);lastMeasuredWidth=w;}
+'''+methods+'''
+static void check(boolean ok){if(!ok)throw new AssertionError();}
+void verify(){onMeasure(2000,40);check(totalWidth==calculateTotalWidth());check(totalWidth==measuredWidth);check(maxStableWidth==calculateMaxStableWidth(totalWidth));check(maxItemWidth==(items.isEmpty()?0:totalWidth/items.size()));check(children==items.size());}
+public static void main(String[] args){TabWidthTest t=new TabWidthTest();
+// Exact reported crash: stale 1244 after removing a 343px profile tab.
+t.addItemAtIndex(new Item(400),-1);t.addItemAtIndex(new Item(501),-1);t.addItemAtIndex(new Item(343),-1);check(t.totalWidth==1244);t.selectionFactor=2;t.removeItemAt(2);check(t.totalWidth==901);check(t.selectionFactor==1);t.verify();
+t.removeItemAt(0);check(t.selectionFactor==0);t.verify();t.removeItemAt(0);check(t.selectionFactor==0&&t.totalWidth==0);t.verify();check(t.calculateCommonItemWidth(500)==0);
+t.showLabelOnActiveOnly=true;t.itemPadding=8;t.addItemAtIndex(new Item(180),0);check(t.selectionFactor==0);t.verify();t.addItemAtIndex(new Item(90),0);check(t.selectionFactor==1);t.verify();
+// Recover every dependent cache when widths change between measurement passes.
+t.items.get(0).width+=37;t.lastMeasuredWidth=999;t.onMeasure(1000,40);t.verify();
+for(int i=0;i<200;i++){t.addItemAtIndex(new Item(50+i),-1);t.verify();}while(!t.items.isEmpty()){t.removeItemAt(t.items.size()/2);t.verify();}
+System.out.println("PASS: actual tab methods reproduce 1244 -> 901; remove/insert/selection, empty tabs, active-label widths, stale-cache recovery and 200 mutations");}
+}
+'''
+with tempfile.TemporaryDirectory() as tmp:
+ p=Path(tmp)/'TabWidthTest.java';p.write_text(java)
+ subprocess.run(['java','com.sun.tools.javac.Main','-d',tmp,str(p)],check=True)
+ subprocess.run(['java','-cp',tmp,'TabWidthTest'],check=True)
