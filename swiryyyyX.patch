+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.ui;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.widget.LinearLayout;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.component.sticker.TGStickerObj;
+import org.thunderdog.challegram.loader.ImageReceiver;
+import org.thunderdog.challegram.loader.gif.GifReceiver;
+import org.thunderdog.challegram.loader.gif.GifFile;
+import org.thunderdog.challegram.telegram.Tdlib;
+import org.thunderdog.challegram.tool.Screen;
+
+/** The collectible's actual symbol, decoded once as a still frame and repeated behind its model. */
+class SviriGiftPatternLayout extends LinearLayout {
+  private final ImageReceiver image = new ImageReceiver(this, 0);
+  private final GifReceiver animation = new GifReceiver(this);
+  private boolean patterned;
+  SviriGiftPatternLayout(Context context) { super(context); setWillNotDraw(false); setClipToOutline(true); }
+  void setGift(Tdlib tdlib, TdApi.UpgradedGift gift) {
+    patterned = gift != null;
+    if (gift == null) { image.requestFile(null); animation.requestFile(null); invalidate(); return; }
+    TdApi.Sticker symbol = gift.symbol.sticker;
+    TGStickerObj object = new TGStickerObj(tdlib, symbol, null, symbol.fullType);
+    GifFile still = object.getPreviewAnimation(); if (still != null) still.setIsStill(true);
+    image.requestFile(object.getImage()); animation.requestFile(still);
+    int color = 0xff000000 | gift.backdrop.colors.symbolColor;
+    image.setPorterDuffColorFilter(color); animation.setPorterDuffColorFilter(color);
+    image.setAlpha(.24f); animation.setAlpha(.24f); invalidate();
+  }
+  @Override protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+    super.onSizeChanged(w, h, oldw, oldh);
+    int size = Screen.dp(w > Screen.dp(220) ? 38 : 25);
+    image.setBounds(0, 0, size, size); animation.setBounds(0, 0, size, size);
+  }
+  @Override protected void onDraw(Canvas canvas) {
+    super.onDraw(canvas);
+    if (!patterned) return;
+    for (int row = 0; row < 3; row++) {
+      for (int side = 0; side < 2; side++) {
+        int left = (int)(getWidth() * (side == 0 ? .08f : .76f));
+        int top = (int)(getHeight() * (.09f + .27f * row));
+        int restore = canvas.save(); canvas.translate(left, top);
+        if (animation.needPlaceholder()) image.draw(canvas); else animation.draw(canvas);
+        canvas.restoreToCount(restore);
+      }
+    }
+  }
+  @Override protected void onAttachedToWindow() { super.onAttachedToWindow(); image.attach(); animation.attach(); }
+  @Override protected void onDetachedFromWindow() { image.detach(); animation.detach(); super.onDetachedFromWindow(); }
+  void destroyPattern() { image.destroy(); animation.destroy(); }
+}
