@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+/** Unknown and incomplete history must never look like zero activity. */
+public final class ChatActivityPolicy {
+  public static int compareLastMessage(int a,int b,long aid,long bid){
+    if(a<=0&&b>0)return 1;if(b<=0&&a>0)return -1;
+    int c=Integer.compare(a,b);return c!=0?c:Long.compare(aid,bid);
+  }
+  public static final class Sample {
+    public final int count;public final boolean exact;
+    public Sample(int count,boolean exact){this.count=count;this.exact=exact;}
+  }
+  public static Sample sample(int[] dates,int since){
+    if(dates==null||dates.length==0)return new Sample(-1,false);
+    int count=0;boolean crossed=false,valid=false;
+    for(int date:dates){if(date>0)valid=true;if(date>=since)count++;else if(date>0)crossed=true;}
+    return new Sample(valid?count:-1,crossed);
+  }
+}
