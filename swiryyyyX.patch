--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/telegram/FolderForwardSender.java
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.data.TD;
+import org.thunderdog.challegram.tool.UI;
+import org.thunderdog.challegram.unsorted.Settings;
+import java.util.List;
+import java.util.HashSet;
+import java.util.HashMap;
+import java.util.function.Consumer;
+
+/** Await actual TDLib send-success updates, including album messages and early replies. */
+public final class FolderForwardSender implements MessageListener {
+  private final Tdlib tdlib;
+  private long chatId;
+  private List<TdApi.Function<?>> functions;
+  private int next, generation;
+  private Consumer<String> complete;
+  private boolean awaitingResult;
+  private final HashSet<Long> pending = new HashSet<>(), earlySuccess = new HashSet<>();
+  private final HashMap<Long, TdApi.Error> earlyErrors = new HashMap<>();
+  private final HashMap<Long, Double> earlyWait = new HashMap<>();
+  private Runnable timeout;
+  public FolderForwardSender (Tdlib tdlib) { this.tdlib = tdlib; }
+  public void send (long chatId, List<TdApi.Function<?>> functions, Consumer<String> complete) {
+    cancel(); this.chatId = chatId; this.functions = functions; this.complete = complete; next = 0;
+    tdlib.listeners().subscribeToMessageUpdates(chatId, this); next();
+  }
+  public void cancel () {
+    generation++;
+    if (chatId != 0) tdlib.listeners().unsubscribeFromMessageUpdates(chatId, this);
+    if (timeout != null) UI.removePendingRunnable(timeout);
+    timeout = null; complete = null; functions = null; chatId = 0;
+    pending.clear(); earlySuccess.clear(); earlyErrors.clear(); earlyWait.clear(); awaitingResult = false;
+  }
+  private void finish (String error) { Consumer<String> callback = complete; cancel(); if (callback != null) callback.accept(error); }
+  private void fail (TdApi.Error error, double retryAfter) {
+    long seconds = Math.max(FolderForwardQueue.retrySeconds(error.message), (long) Math.ceil(retryAfter));
+    if (seconds > 0 && seconds < (Long.MAX_VALUE - System.currentTimeMillis()) / 1000L) {
+      String key = "sviri_forward_cooldown_" + tdlib.id();
+      Settings.instance().putLong(key, Math.max(Settings.instance().getLong(key, 0), System.currentTimeMillis() + seconds * 1000L));
+    }
+    finish(TD.toErrorString(error));
+  }
+  private void next () {
+    if (complete == null) return;
+    if (next >= functions.size()) { finish(null); return; }
+    pending.clear(); earlySuccess.clear(); earlyErrors.clear(); earlyWait.clear(); awaitingResult = true;
+    int token = ++generation;
+    if (timeout != null) UI.removePendingRunnable(timeout);
+    timeout = () -> { if (complete != null && token == generation) finish("Telegram did not confirm delivery. Remaining chats were not sent."); };
+    UI.post(timeout, 60000L);
+    tdlib.client().send(functions.get(next++), result -> {
+      // Preserve Telegram X cache and message-list updates even if the picker was closed.
+      if (result instanceof TdApi.Message || result instanceof TdApi.Messages) tdlib.messageHandler().onResult(result);
+      UI.post(() -> {
+      if (complete == null || token != generation) return;
+      if (result instanceof TdApi.Error) { fail((TdApi.Error) result, 0); return; }
+      TdApi.Message[] messages = result instanceof TdApi.Message ? new TdApi.Message[]{(TdApi.Message) result} : result instanceof TdApi.Messages ? ((TdApi.Messages) result).messages : null;
+      if (messages == null || messages.length == 0) { finish("Telegram returned no forwarded messages."); return; }
+      for (TdApi.Message message : messages) {
+        if (message == null) { finish("Telegram could not forward one of the selected messages."); return; }
+        if (message.sendingState instanceof TdApi.MessageSendingStateFailed) {
+          TdApi.MessageSendingStateFailed failure = (TdApi.MessageSendingStateFailed) message.sendingState;
+          fail(failure.error, failure.retryAfter); return;
+        }
+        TdApi.Error earlyError = earlyErrors.get(message.id);
+        if (earlyError != null) { fail(earlyError, earlyWait.getOrDefault(message.id, 0d)); return; }
+        if (message.sendingState != null && !earlySuccess.contains(message.id)) pending.add(message.id);
+      }
+      awaitingResult = false;
+      if (pending.isEmpty()) next();
+      });
+    });
+  }
+  @Override public void onMessageSendSucceeded (TdApi.Message message, long oldMessageId) {
+    UI.post(() -> {
+      if (complete == null || message.chatId != chatId) return;
+      if (awaitingResult) { if (earlySuccess.size() < 1000) earlySuccess.add(oldMessageId); return; }
+      if (pending.remove(oldMessageId) && pending.isEmpty()) next();
+    });
+  }
+  @Override public void onMessageSendFailed (TdApi.Message message, long oldMessageId, TdApi.Error error) {
+    UI.post(() -> {
+      if (complete == null || message.chatId != chatId) return;
+      if (awaitingResult) {
+        if (earlyErrors.size() < 1000) {
+          earlyErrors.put(oldMessageId, error);
+          if (message.sendingState instanceof TdApi.MessageSendingStateFailed) earlyWait.put(oldMessageId, ((TdApi.MessageSendingStateFailed) message.sendingState).retryAfter);
+        }
+        return;
+      }
+      if (pending.contains(oldMessageId)) {
+        double retryAfter = message.sendingState instanceof TdApi.MessageSendingStateFailed ? ((TdApi.MessageSendingStateFailed) message.sendingState).retryAfter : 0;
+        fail(error, retryAfter);
+      }
+    });
+  }
+}
diff --git a/app/src/main/java/org/thunderdog/challegram/telegram/FolderForwardTask.java b/app/src/main/java/org/thunderdog/challegram/telegram/FolderForwardTask.java
new file mode 100644
index 00000000..6442f7af
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/telegram/FolderForwardTask.java
@@ -0,0 +1,82 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import android.widget.Toast;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.tool.UI;
+import org.thunderdog.challegram.unsorted.Settings;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.function.Consumer;
+
+/** UI-thread queue owner independent of the dismissed share window. No automatic replay. */
+public final class FolderForwardTask {
+  private static final HashMap<Integer, FolderForwardTask> active = new HashMap<>();
+  private static final String JOB_ID = "swir-folder-forward";
+  public static final class Batch {
+    final long chatId;
+    final List<TdApi.Function<?>> functions;
+    public Batch (long chatId, List<TdApi.Function<?>> functions) {
+      this.chatId = chatId; this.functions = new ArrayList<>(functions);
+    }
+  }
+  private final Tdlib tdlib;
+  private final long sourceUserId;
+  private final ArrayList<Batch> batches;
+  private final FolderForwardSender sender;
+  private final FolderForwardQueue queue;
+  private final Object owner;
+  private final Consumer<String> completion;
+
+  /** Returns an error without starting, or null once ownership has transferred to this task. */
+  public static String start (Tdlib tdlib, List<Batch> batches) {
+    return start(tdlib, batches, null, null);
+  }
+  public static String start (Tdlib tdlib, List<Batch> batches, Object owner, Consumer<String> completion) {
+    if (active.containsKey(tdlib.id())) return Lang.getString(R.string.SviriFolderBusy);
+    if (batches.isEmpty()) return Lang.getString(R.string.SviriFolderLoadFailed);
+    long remaining = Settings.instance().getLong("sviri_forward_cooldown_" + tdlib.id(), 0) - System.currentTimeMillis();
+    if (remaining > 0) return Lang.getString(R.string.SviriFolderCooldown, (remaining + 999L) / 1000L);
+    FolderForwardTask task = new FolderForwardTask(tdlib, batches, owner, completion);
+    active.put(tdlib.id(), task);
+    tdlib.incrementJobReferenceCount(JOB_ID);
+    task.queue.start();
+    return null;
+  }
+  public static void cancelOwned (Tdlib tdlib, Object owner) {
+    FolderForwardTask task = active.get(tdlib.id());
+    if (task != null && owner != null && task.owner == owner) {
+      task.queue.cancel(); task.finish("Stopped. No automatic retry.");
+    }
+  }
+  private FolderForwardTask (Tdlib tdlib, List<Batch> batches, Object owner, Consumer<String> completion) {
+    this.tdlib = tdlib; this.sourceUserId = tdlib.myUserId(); this.batches = new ArrayList<>(batches);
+    this.owner = owner; this.completion = completion;
+    sender = new FolderForwardSender(tdlib);
+    queue = new FolderForwardQueue(batches.size(), (index, callback) -> {
+      if (tdlib.myUserId() != sourceUserId) { callback.accept(Lang.getString(R.string.SviriAccountChanged)); return; }
+      Batch batch = this.batches.get(index);
+      if (tdlib.settings().isChatHidden(batch.chatId)) {
+        callback.accept(Lang.getString(R.string.SviriFolderRecipientChanged)); return;
+      }
+      // Permissions were checked in the picker; TDLib validates again on each send.
+      sender.send(batch.chatId, batch.functions, callback);
+    }, UI::post, new FolderForwardQueue.Listener() {
+      @Override public void progress (int completed, int total) { }
+      @Override public void finished () { finish(null); }
+      @Override public void failed (String error) { finish(error); }
+    });
+  }
+  private void finish (String error) {
+    int completed = queue.completed(), total = batches.size();
+    sender.cancel(); active.remove(tdlib.id()); batches.clear();
+    tdlib.decrementJobReferenceCount(JOB_ID);
+    String status = error == null ? Lang.getString(R.string.SviriFolderFinished, completed)
+      : Lang.getString(R.string.SviriFolderStopped, completed, total, error);
+    if (completion != null) completion.accept(error == null ? null : status);
+    else UI.showToast(status, Toast.LENGTH_LONG);
+  }
+}
diff --git a/app/src/main/java/org/thunderdog/challegram/telegram/FolderSnapshot.java b/app/src/main/java/org/thunderdog/challegram/telegram/FolderSnapshot.java
new file mode 100644
index 00000000..db8ca766
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/telegram/FolderSnapshot.java
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+import java.util.*;
+import java.util.function.Consumer;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.tool.UI;
+/** Resolve explicit folders directly; rule-based folders still use complete paged membership. */
+public final class FolderSnapshot {
+  private final Tdlib tdlib;private final long user;private final int folder;
+  private final Consumer<long[]> success;private final Consumer<String> failure;
+  private boolean active=true,pumping;private int next,pending;private long[] ids;
+  private FolderForwardLoader loader;
+  public FolderSnapshot(Tdlib t,int folder,Consumer<long[]> ok,Consumer<String> error){tdlib=t;user=t.myUserId();this.folder=folder;success=ok;failure=error;}
+  private boolean current(){return active&&tdlib.myUserId()==user;}
+  public void cancel(){active=false;if(loader!=null)loader.cancel();}
+  private void fail(String reason){if(!current())return;cancel();failure.accept(reason);}
+  public void start(long[] values){timeout();resolved(values.clone());}
+  private void timeout(){UI.post(()->fail("Не вдалося завантажити папку за 60 секунд. Спробуй ще раз після підключення."),60000L);}
+  public void start(){
+    timeout();
+    tdlib.client().send(new TdApi.GetChatFolder(folder),r->UI.post(()->{
+      if(!current())return;
+      if(!(r instanceof TdApi.ChatFolder)){fail(r instanceof TdApi.Error?((TdApi.Error)r).message:"Папка недоступна");return;}
+      TdApi.ChatFolder f=(TdApi.ChatFolder)r;
+      if(!f.includeContacts&&!f.includeNonContacts&&!f.includeBots&&!f.includeGroups&&!f.includeChannels){
+        LinkedHashSet<Long> all=new LinkedHashSet<>();for(long id:f.pinnedChatIds)if(id!=0)all.add(id);for(long id:f.includedChatIds)if(id!=0)all.add(id);
+        for(long id:f.excludedChatIds)all.remove(id);resolved(all.stream().mapToLong(Long::longValue).toArray());
+      }else paged();
+    }));
+  }
+  private void paged(){TdApi.ChatList list=new TdApi.ChatListFolder(folder);
+    loader=new FolderForwardLoader(new FolderForwardLoader.Transport(){
+      public void loadMore(Consumer<Integer> cb){tdlib.client().send(new TdApi.LoadChats(list,100),r->UI.post(()->{if(current())cb.accept(r instanceof TdApi.Ok?0:r instanceof TdApi.Error?((TdApi.Error)r).code:-1);}));}
+      public void snapshot(Consumer<long[]> cb){tdlib.client().send(new TdApi.GetChats(list,FolderForwardLoader.SNAPSHOT_LIMIT),r->UI.post(()->{if(current())cb.accept(r instanceof TdApi.Chats?((TdApi.Chats)r).chatIds:null);}));}
+    },new FolderForwardLoader.Listener(){public void complete(long[] values){resolved(values);}public void failed(){fail("Не вдалося отримати повний список папки. Нічого не надіслано.");}});loader.start();
+  }
+  private void resolved(long[] values){if(!current())return;ids=values;prepare();}
+  private void prepare(){
+    if(!current()||pumping)return;pumping=true;
+    while(current()&&pending<8&&next<ids.length){long id=ids[next++];if(tdlib.chat(id)!=null)continue;pending++;
+      tdlib.client().send(new TdApi.GetChat(id),r->UI.post(()->{if(!current())return;pending--;if(!(r instanceof TdApi.Chat)){fail("Не вдалося перевірити один із чатів. Онови папку.");return;}prepare();}));
+    }pumping=false;
+    if(current()&&next==ids.length&&pending==0){active=false;success.accept(ids.clone());}
+  }
+}
