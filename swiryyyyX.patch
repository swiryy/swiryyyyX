new file mode 100644
index 00000000..cc3124eb
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/sync/FolderForwardWork.java
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.sync;
+
+import android.content.Context;
+import androidx.annotation.NonNull;
+import androidx.work.*;
+import java.util.*;
+import java.util.concurrent.*;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.data.TD;
+import org.thunderdog.challegram.telegram.*;
+import org.thunderdog.challegram.tool.UI;
+import org.thunderdog.challegram.unsorted.AppContext;
+import org.thunderdog.challegram.unsorted.Settings;
+
+/** User-enabled Android-only periodic forwarding. Unknown delivery or errors pause the schedule. */
+public final class FolderForwardWork extends Worker {
+  public static final int MINUTES = 30;
+  private volatile Tdlib runningTdlib;
+  private final CountDownLatch done = new CountDownLatch(1);
+  private final java.util.concurrent.atomic.AtomicBoolean completed = new java.util.concurrent.atomic.AtomicBoolean();
+  private volatile String token;
+  private int accountId;
+  public FolderForwardWork(@NonNull Context context,@NonNull WorkerParameters parameters) { super(context,parameters); }
+  private static String key(int account,String suffix) { return "sviri_periodic_"+account+"_"+suffix; }
+  private static String workName(int account) { return "sviri-periodic-folder:"+account; }
+  public static boolean enabled(int account) { return !Settings.instance().getString(key(account,"token"),"").isEmpty(); }
+  public static String status(int account) { return Settings.instance().getString(key(account,"status"),"Розклад не налаштовано"); }
+  public static void pauseSchedule(int account) {
+    Settings.instance().putString(key(account,"token"),"");
+    Settings.instance().putString(key(account,"status"),"Призупинено");
+    WorkManager.getInstance(AppContext.get()).cancelUniqueWork(workName(account));
+  }
+  /** Receives the exact group snapshot reviewed by the user, never adds recipients silently. */
+  public static void schedule(Tdlib tdlib,int folderId,long[] groups) {
+    if(groups==null||groups.length==0||groups.length>1000||tdlib.myUserId()==0)throw new IllegalArgumentException("Invalid schedule");
+    pauseSchedule(tdlib.id());
+    String token=UUID.randomUUID().toString();
+    Data data=new Data.Builder().putInt("account",tdlib.id()).putLong("user",tdlib.myUserId()).putInt("folder",folderId)
+      .putString("token",token).putLongArray("groups",groups.clone()).build();
+    PeriodicWorkRequest request=new PeriodicWorkRequest.Builder(FolderForwardWork.class,MINUTES,TimeUnit.MINUTES)
+      .setInitialDelay(MINUTES,TimeUnit.MINUTES).setInputData(data)
+      .setConstraints(new Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build()).build();
+    Settings.instance().putLong(key(tdlib.id(),"inflight"),0);
+    Settings.instance().putString(key(tdlib.id(),"status"),"Увімкнено: приблизно кожні 30 хвилин; "+groups.length+" перевірених груп");
+    Settings.instance().putString(key(tdlib.id(),"token"),token);
+    WorkManager.getInstance(AppContext.get()).enqueueUniquePeriodicWork(workName(tdlib.id()),ExistingPeriodicWorkPolicy.REPLACE,request);
+  }
+  private boolean current() { return !isStopped()&&token!=null&&token.equals(Settings.instance().getString(key(accountId,"token"),"")); }
+  private void finish(String error) {
+    if (!completed.compareAndSet(false, true)) return;
+    if(current()) {
+      Settings.instance().putLong(key(accountId,"inflight"),0);
+      Settings.instance().putString(key(accountId,"status"),error==null?"Останній запуск завершено: "+new java.util.Date():"Призупинено: "+error);
+      if(error!=null)Settings.instance().putString(key(accountId,"token"),"");
+    }
+    done.countDown();
+  }
+  @NonNull @Override public Result doWork() {
+    Data input=getInputData(); accountId=input.getInt("account",-1);token=input.getString("token");
+    long user=input.getLong("user",0);long[] groups=input.getLongArray("groups");
+    if(accountId<0||user==0||groups==null||groups.length==0||groups.length>1000||!current())return Result.success();
+    if(Settings.instance().getLong(key(accountId,"inflight"),0)!=0) {
+      finish("Попередній запуск перервано. Переглянь список і ввімкни знову; повторного надсилання не буде.");return Result.success();
+    }
+    try {
+      TdlibManager manager=TdlibManager.instanceForAccountId(accountId);
+      if(!manager.hasAccount(accountId)||manager.account(accountId).getKnownUserId()!=user) { finish("Акаунт змінився");return Result.success(); }
+      runningTdlib=manager.tdlib(accountId);Tdlib tdlib=runningTdlib;
+      tdlib.incrementJobReferenceCount("sviri-periodic-prepare");
+      try {
+        tdlib.awaitInitialization(()->UI.post(()->{
+          if(!current()){done.countDown();return;}
+          if(!tdlib.isAuthorized()||tdlib.myUserId()!=user){finish("Увійди знову, щоб увімкнути цей розклад");return;}
+          // Persist before any network work: process death must never replay a partially delivered run.
+          Settings.instance().putLong(key(accountId,"inflight"),System.currentTimeMillis());
+          tdlib.client().send(new TdApi.GetChatHistory(tdlib.selfChatId(),0,0,1,false),result->UI.post(()->{
+            if(!current()){done.countDown();return;}
+            if(!(result instanceof TdApi.Messages)||((TdApi.Messages)result).messages.length==0){finish("Не вдалося отримати останнє повідомлення зі Збереженого");return;}
+            TdApi.Message message=((TdApi.Messages)result).messages[0];
+            if(message==null||message.sendingState!=null||message.mediaAlbumId!=0){finish("Останнє повідомлення ще надсилається або належить альбому; вибери окреме повідомлення");return;}
+            tdlib.client().send(new TdApi.GetMessageProperties(message.chatId,message.id),properties->UI.post(()->{
+              if(!current()){done.countDown();return;}
+              if(!(properties instanceof TdApi.MessageProperties)||!((TdApi.MessageProperties)properties).canBeForwarded){finish("Останнє повідомлення зі Збереженого не можна переслати");return;}
+              resolveRecipients(tdlib,groups,0,()->{
+              ArrayList<FolderForwardTask.Batch> batches=new ArrayList<>();HashSet<Long> seen=new HashSet<>();
+              for(long id:groups) {
+                TdApi.Chat chat=tdlib.chat(id);
+                boolean group=chat!=null&&(chat.type instanceof TdApi.ChatTypeBasicGroup||chat.type instanceof TdApi.ChatTypeSupergroup&&!((TdApi.ChatTypeSupergroup)chat.type).isChannel);
+                if(!group||tdlib.settings().isChatHidden(id)||!tdlib.canSendBasicMessage(chat)||!seen.add(id)){finish("Один з одержувачів недоступний. Переглянь папку знову.");return;}
+                TdApi.MessageSendOptions options=new TdApi.MessageSendOptions();options.paidMessageStarCount=0;
+                TdApi.ForwardMessages forward=new TdApi.ForwardMessages(id,null,message.chatId,new long[]{message.id},options,false,false);
+                batches.add(new FolderForwardTask.Batch(id,Collections.singletonList(forward)));
+              }
+              String error=FolderForwardTask.start(tdlib,batches,this,this::finish);if(error!=null)finish(error);
+              });
+            }));
+          }));
+        }));
+        if(!done.await(8,TimeUnit.MINUTES)) {
+          UI.post(()->FolderForwardTask.cancelOwned(tdlib,this));finish("Час надсилання вичерпано. Перевір стан перед повторним увімкненням.");
+        }
+      } finally { tdlib.decrementJobReferenceCount("sviri-periodic-prepare"); }
+    }catch(InterruptedException interrupted) { Thread.currentThread().interrupt();onStopped(); }
+    catch(RuntimeException failure) { finish("Не вдалося запустити розклад"); }
+    // No retry: next periodic execution is permitted only while the saved token remains enabled.
+    return Result.success();
+  }
+  private void resolveRecipients(Tdlib tdlib,long[] ids,int index,Runnable ready) {
+    if(!current()||completed.get()){done.countDown();return;}
+    while(index<ids.length&&tdlib.chat(ids[index])!=null)index++;
+    if(index==ids.length){ready.run();return;}
+    final int next=index+1;
+    tdlib.client().send(new TdApi.GetChat(ids[index]),result->UI.post(()->{
+      if(result instanceof TdApi.Chat)resolveRecipients(tdlib,ids,next,ready);
+      else finish("Не вдалося перевірити доступ до одержувачів. Переглянь список і ввімкни знову.");
+    }));
+  }
+  @Override public void onStopped() {
+    Tdlib tdlib=runningTdlib;
+    if(tdlib!=null)UI.post(()->FolderForwardTask.cancelOwned(tdlib,this));
+    if(token!=null&&token.equals(Settings.instance().getString(key(accountId,"token"),""))) {
+      Settings.instance().putString(key(accountId,"token"),"");
+      Settings.instance().putString(key(accountId,"status"),"Призупинено після переривання; перевір перед повторним запуском");
+    }
+    done.countDown();
+  }
+}
