+            if (!(lo instanceof TdApi.OptionValueInteger) || !(hi instanceof TdApi.OptionValueInteger)
+              || GiftResalePolicy.parseStars(Long.toString(price), ((TdApi.OptionValueInteger)lo).value, ((TdApi.OptionValueInteger)hi).value) != price) {
+              fail(new TdApi.Error(400, Lang.getString(R.string.SviriGiftPriceChanged))); return;
+            }
