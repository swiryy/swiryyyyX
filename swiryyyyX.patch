@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Local, persistent folder ranks. Does not change Telegram pin state. */
+public final class FolderChatOrder {
+  public interface Storage { long[] read(); void write(long[] ids); }
+  private final Storage storage;
+  private final Map<Long, Long> ranks = new LinkedHashMap<>();
+  public FolderChatOrder(Storage storage) {
+    this.storage = storage;
+    long[] ids = storage.read();
+    if (ids != null) for (long id : ids) if (id != 0 && !ranks.containsKey(id)) ranks.put(id, (long) ranks.size());
+  }
+  public synchronized void remember(long[] ids) {
+    boolean changed = false;
+    for (long id : ids) if (id != 0 && !ranks.containsKey(id)) {
+      ranks.put(id, (long) ranks.size()); changed = true;
+    }
+    if (changed) {
+      long[] ordered = new long[ranks.size()]; int i = 0;
+      for (long id : ranks.keySet()) ordered[i++] = id;
+      storage.write(ordered);
+    }
+  }
+  public synchronized void replace(long[] ids) {
+    ranks.clear(); remember(ids);
+    if (ids.length == 0) storage.write(new long[0]);
+  }
+  public synchronized long rank(long id) {
+    if (!ranks.containsKey(id)) remember(new long[]{id});
+    return ranks.get(id);
+  }
+}
