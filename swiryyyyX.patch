+  private static final String HIDDEN_CHATS_KEY = "sviri_hidden_chats";
+  private volatile HiddenChatStore hiddenChats;
+  private final java.util.concurrent.CopyOnWriteArrayList<HiddenChatsListener> hiddenChatsListeners = new java.util.concurrent.CopyOnWriteArrayList<>();
+
+  public interface HiddenChatsListener {
+    void onHiddenChatChanged (long chatId);
+  }
+
+  private HiddenChatStore hiddenChats () {
+    HiddenChatStore store = hiddenChats;
+    if (store == null) {
+      synchronized (this) {
+        store = hiddenChats;
+        if (store == null) {
+          final String storageKey = key(HIDDEN_CHATS_KEY, tdlib.id());
+          hiddenChats = store = new HiddenChatStore(new HiddenChatStore.Storage() {
+            @Override public long[] read () { return Settings.instance().getLongArray(storageKey); }
+            @Override public void write (long[] ids) { Settings.instance().putLongArray(storageKey, ids); }
+          });
+        }
+      }
+    }
+    return store;
+  }
+
+  public boolean isChatHidden (long chatId) {
+    return hiddenChats().contains(chatId);
+  }
+
+  public boolean hasHiddenChats () {
+    return !hiddenChats().isEmpty();
+  }
+
+  public long[] hiddenChatIds () {
+    return hiddenChats().chatIds();
+  }
+
+  public void setChatHidden (long chatId, boolean hidden) {
+    setChatsHidden(new long[] {chatId}, hidden);
+  }
+
+  public void setChatsHidden (long[] chatIds, boolean hidden) {
+    long[] changed = hiddenChats().setHidden(chatIds, hidden);
+    if (changed.length == 0) return;
+    tdlib.runOnTdlibThread(() -> {
+      for (long chatId : changed) {
+        for (HiddenChatsListener listener : hiddenChatsListeners) listener.onHiddenChatChanged(chatId);
+        tdlib.notifications().onUpdateNotifications(chatId);
+      }
+      tdlib.refreshLocalVisibilityCounters();
+    });
+  }
+
+  public void addHiddenChatsListener (HiddenChatsListener listener) {
+    hiddenChatsListeners.addIfAbsent(listener);
+  }
+
+  public void removeHiddenChatsListener (HiddenChatsListener listener) {
+    hiddenChatsListeners.remove(listener);
+  }
+
