+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+import org.drinkless.tdlib.TdApi;
+
+/** Eligibility and integer bounds from the server, without guessing a price or commission. */
+public final class GiftResalePolicy {
+  private GiftResalePolicy() { }
+  public static boolean eligible(TdApi.ReceivedGift gift, long now) {
+    return gift != null && gift.receivedGiftId != null && !gift.receivedGiftId.isEmpty()
+      && !gift.wasRefunded && gift.gift instanceof TdApi.SentGiftUpgraded
+      && gift.nextResaleDate > 0 && gift.nextResaleDate <= now;
+  }
+  public static long parseStars(String input, long min, long max) {
+    if (min <= 0 || max < min || input == null || !input.matches("[0-9]{1,19}")) return -1;
+    try { long value = Long.parseLong(input); return value >= min && value <= max ? value : -1; }
+    catch (NumberFormatException e) { return -1; }
+  }
+}
