+      linkAction(R.string.Share, () -> leave(() -> {
+        ShareController share = new ShareController(parent.context(), tdlib);
+        share.setArguments(new ShareController.Args(link)); share.show();
+      }));
+      linkAction(R.string.CopyLink, () -> UI.copyText(link, R.string.CopiedLink));
+    }
+    linkAction(R.string.SviriGiftBuy, () -> leave(buy));
+    if (content.isAttachedToWindow()) sticker.attach();
+  }
+  private void linkAction(int label, Runnable run) {
+    TextView button = text(Lang.getString(label), 14, Theme.getColor(ColorId.textLink)); button.setGravity(Gravity.CENTER); button.setMinHeight(Screen.dp(44));
+    clickable(button, Theme.getColor(ColorId.filling), 14, run); add(content, button, 8);
+  }
+  @Override public void destroy() {
+    if (isDestroyed()) return;
+    if (readTimeout != null) UI.removePendingRunnable(readTimeout);
+    if (heroPattern != null) heroPattern.destroyPattern();
+    if (sticker != null) sticker.performDestroy();
+    sticker = null; super.destroy();
+  }
+}
diff --git a/app/src/main/java/org/thunderdog/challegram/ui/SviriGiftFlow.java b/app/src/main/java/org/thunderdog/challegram/ui/SviriGiftFlow.java
