+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+/** Metadata warm-up policy. Never requests message history or media. */
+public final class PriorityChatPolicy {
+  private PriorityChatPolicy () { }
+
+  public static boolean eager (boolean direct, boolean channel, int memberCount) {
+    return direct || (!channel && memberCount > 0 && memberCount <= 200);
+  }
+}
