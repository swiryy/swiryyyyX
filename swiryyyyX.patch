+    if (order == null) {
+      final String storageKey = key(FOLDER_ORDER_PREFIX, tdlib.id()) + folderId + "_ids";
+      order = new FolderChatOrder(new FolderChatOrder.Storage() {
+        @Override public long[] read() { return Settings.instance().getLongArray(storageKey); }
+        @Override public void write(long[] ids) { Settings.instance().putLongArray(storageKey, ids); }
+      });
