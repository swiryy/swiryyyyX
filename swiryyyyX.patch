new file mode 100644
index 00000000..887f5112
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/ui/SettingsHiddenChatsController.java
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.ui;
+
+import android.content.Context;
+import android.view.View;
+
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.telegram.Tdlib;
+import org.thunderdog.challegram.telegram.TdlibSettingsManager;
+import org.thunderdog.challegram.telegram.TdlibUi;
+import org.thunderdog.challegram.v.CustomRecyclerView;
+
+import java.util.ArrayList;
+
+public final class SettingsHiddenChatsController extends RecyclerViewController<Void>
+    implements View.OnClickListener, TdlibSettingsManager.HiddenChatsListener {
+  private SettingsAdapter adapter;
+
+  public SettingsHiddenChatsController (Context context, Tdlib tdlib) {
+    super(context, tdlib);
+  }
+
+  @Override public int getId () { return R.id.controller_hiddenChats; }
+  @Override public CharSequence getName () { return Lang.getString(R.string.SviriHiddenChats); }
+
+  @Override
+  protected void onCreateView (Context context, CustomRecyclerView recyclerView) {
+    adapter = new SettingsAdapter(this);
+    recyclerView.setAdapter(adapter);
+    tdlib.settings().addHiddenChatsListener(this);
+    rebuildItems();
+    for (long chatId : tdlib.settings().hiddenChatIds()) {
+      if (tdlib.chat(chatId) == null) {
+        tdlib.chat(chatId, () -> new TdApi.GetChat(chatId), chat -> runOnUiThreadOptional(this::rebuildItems));
+      }
+    }
+  }
+
+  private void rebuildItems () {
+    if (adapter == null || isDestroyed()) return;
+    ArrayList<ListItem> items = new ArrayList<>();
+    items.add(new ListItem(ListItem.TYPE_DESCRIPTION, 0, 0, R.string.SviriHiddenChatsHint));
+    long[] hidden = tdlib.settings().hiddenChatIds();
+    if (hidden.length == 0) {
+      items.add(new ListItem(ListItem.TYPE_EMPTY, 0, 0, R.string.SviriNoHiddenChats));
+    } else {
+      items.add(new ListItem(ListItem.TYPE_SHADOW_TOP));
+      for (int i = 0; i < hidden.length; i++) {
+        long chatId = hidden[i];
+        TdApi.Chat chat = tdlib.chat(chatId);
+        String title = chat != null ? chat.title : Long.toString(chatId);
+        items.add(new ListItem(ListItem.TYPE_SETTING, R.id.btn_hiddenChat, R.drawable.baseline_eye_off_24, title).setLongId(chatId));
+        if (i + 1 < hidden.length) items.add(new ListItem(ListItem.TYPE_SEPARATOR));
+      }
+      items.add(new ListItem(ListItem.TYPE_SHADOW_BOTTOM));
+    }
+    adapter.setItems(items, false);
+  }
+
+  @Override
+  public void onClick (View view) {
+    if (view.getId() != R.id.btn_hiddenChat || !(view.getTag() instanceof ListItem)) return;
+    long chatId = ((ListItem) view.getTag()).getLongId();
+    showOptions(tdlib.chatTitle(chatId),
+      new int[] {R.id.btn_openHiddenChat, R.id.btn_unhideChat},
+      new String[] {Lang.getString(R.string.SviriOpenHiddenChat), Lang.getString(R.string.SviriUnhideChat)},
+      null, new int[] {R.drawable.baseline_chat_bubble_24, R.drawable.baseline_visibility_24},
+      (itemView, id) -> {
+        if (id == R.id.btn_openHiddenChat) {
+          tdlib.ui().openChat(this, chatId, new TdlibUi.ChatOpenParameters().keepStack());
+        } else if (id == R.id.btn_unhideChat) {
+          tdlib.settings().setChatHidden(chatId, false);
+        }
+        return true;
+      });
+  }
+
+  @Override
+  public void onHiddenChatChanged (long chatId) {
+    runOnUiThreadOptional(this::rebuildItems);
+  }
+
+  @Override
+  public void destroy () {
+    tdlib.settings().removeHiddenChatsListener(this);
+    super.destroy();
+  }
+}
diff --git a/app/src/main/java/org/thunderdog/challegram/ui/SettingsStarsController.java b/app/src/main/java/org/thunderdog/challegram/ui/SettingsStarsController.java
new file mode 100644
index 00000000..0097add3
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/ui/SettingsStarsController.java
@@ -0,0 +1,153 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.ui;
+
+import android.content.Context;
+import android.graphics.drawable.GradientDrawable;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import androidx.recyclerview.widget.RecyclerView;
+import org.drinkless.tdlib.TdApi;
+import org.thunderdog.challegram.R;
+import org.thunderdog.challegram.core.Lang;
+import org.thunderdog.challegram.data.TD;
+import org.thunderdog.challegram.telegram.Tdlib;
+import org.thunderdog.challegram.theme.ColorId;
+import org.thunderdog.challegram.theme.Theme;
+import org.thunderdog.challegram.tool.Screen;
+import org.thunderdog.challegram.v.CustomRecyclerView;
+import java.math.BigDecimal;
+import java.text.DateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.function.Consumer;
+
+/** Live account balance, independent of paginated transaction history. */
+public final class SettingsStarsController extends RecyclerViewController<Void> {
+  private final ArrayList<TdApi.StarTransaction> entries = new ArrayList<>();
+  private final HashSet<String> seen = new HashSet<>();
+  private String offset = "", error;
+  private boolean loading, loaded;
+  private int filter, generation;
+  private HistoryAdapter adapter;
+  private final Consumer<TdApi.StarAmount> balanceListener = value -> {
+    if (!isDestroyed() && adapter != null) adapter.notifyItemChanged(0);
+  };
+  public SettingsStarsController (Context context, Tdlib tdlib, boolean gifts) { super(context, tdlib); }
+  @Override public int getId () { return R.id.controller_sviriStars; }
+  @Override public CharSequence getName () { return Lang.getString(R.string.SviriStars); }
+  @Override protected void onCreateView (Context context, CustomRecyclerView recycler) {
+    adapter = new HistoryAdapter(); recycler.setAdapter(adapter); recycler.setItemAnimator(null);
+    recycler.setPadding(Screen.dp(12), Screen.dp(8), Screen.dp(12), Screen.dp(16));
+    tdlib.addStarAmountListener(balanceListener); load();
+  }
+  public static String amount (TdApi.StarAmount value) {
+    return BigDecimal.valueOf(value.starCount).add(BigDecimal.valueOf(value.nanostarCount, 9)).stripTrailingZeros().toPlainString();
+  }
+  private void load () {
+    if (loading || isDestroyed() || (loaded && offset.isEmpty() && error == null)) return;
+    loading = true; error = null; update();
+    final int token = generation;
+    final long userId = tdlib.myUserId(), revision = tdlib.ownedStarAmountRevision();
+    TdApi.TransactionDirection direction = filter == 1 ? new TdApi.TransactionDirectionIncoming() : filter == 2 ? new TdApi.TransactionDirectionOutgoing() : null;
+    tdlib.client().send(new TdApi.GetStarTransactions(new TdApi.MessageSenderUser(userId), "", direction, offset, 30), result -> runOnUiThreadOptional(() -> {
+      if (isDestroyed() || token != generation || userId != tdlib.myUserId()) return;
+      loading = false;
+      if (result instanceof TdApi.StarTransactions) {
+        TdApi.StarTransactions page = (TdApi.StarTransactions) result;
+        tdlib.rememberOwnedStarAmount(userId, revision, page.starAmount);
+        for (TdApi.StarTransaction transaction : page.transactions) if (seen.add(transaction.id)) entries.add(transaction);
+        offset = page.nextOffset; loaded = true;
+      } else error = result instanceof TdApi.Error ? TD.toErrorString(result) : Lang.getString(R.string.SviriUnexpectedResponse);
+      update();
+    }));
+  }
+  private void reset (int nextFilter) {
+    generation++; filter = nextFilter; loading = false; loaded = false; offset = ""; error = null;
+    entries.clear(); seen.clear(); load();
+  }
+  private void update () { if (adapter != null && !isDestroyed()) adapter.notifyDataSetChanged(); }
+  private LinearLayout column (Context context) {
+    LinearLayout wrap = new LinearLayout(context); wrap.setOrientation(LinearLayout.VERTICAL);
+    wrap.setLayoutParams(new RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+    wrap.setPadding(Screen.dp(14), Screen.dp(10), Screen.dp(14), Screen.dp(10));
+    return wrap;
+  }
+  private TextView label (Context context, CharSequence value, int size, int color) {
+    TextView text = new TextView(context); text.setText(value); text.setTextSize(size);
+    text.setTextColor(color); text.setPadding(Screen.dp(8), Screen.dp(8), Screen.dp(8), Screen.dp(8));
+    addThemeInvalidateListener(text);
+    return text;
+  }
+  private String title (TdApi.StarTransaction transaction) {
+    TdApi.StarTransactionType type = transaction.type;
+    if (type instanceof TdApi.StarTransactionTypeGiftPurchase || type instanceof TdApi.StarTransactionTypeUpgradedGiftPurchase || type instanceof TdApi.StarTransactionTypeGiftUpgradePurchase) return Lang.getString(R.string.SviriGiftPurchase);
+    if (type instanceof TdApi.StarTransactionTypeGiftSale || type instanceof TdApi.StarTransactionTypeUpgradedGiftSale) return Lang.getString(R.string.SviriGiftSale);
+    if (type instanceof TdApi.StarTransactionTypeGiftUpgrade) return Lang.getString(R.string.SviriGiftUpgrade);
+    if (type instanceof TdApi.StarTransactionTypeGiftTransfer) return Lang.getString(R.string.SviriGiftTransfer);
+    if (type instanceof TdApi.StarTransactionTypePremiumBotDeposit || type instanceof TdApi.StarTransactionTypeAppStoreDeposit || type instanceof TdApi.StarTransactionTypeGooglePlayDeposit || type instanceof TdApi.StarTransactionTypeFragmentDeposit) return Lang.getString(R.string.SviriStarsTopUp);
+    if (type instanceof TdApi.StarTransactionTypeUserDeposit || type instanceof TdApi.StarTransactionTypeGiveawayDeposit) return Lang.getString(R.string.SviriStarsReceived);
+    if (type instanceof TdApi.StarTransactionTypeFragmentWithdrawal || type instanceof TdApi.StarTransactionTypeTelegramAdsWithdrawal) return Lang.getString(R.string.SviriStarsWithdrawal);
+    return Lang.getString(R.string.SviriStarTransaction);
+  }
+  private final class HistoryAdapter extends RecyclerView.Adapter<RecyclerView.ViewHolder> {
+    @Override public int getItemCount () { return entries.size() + 3; }
+    @Override public int getItemViewType (int position) { return position == 0 ? 0 : position == 1 ? 1 : position < entries.size() + 2 ? 2 : 3; }
+    @Override public RecyclerView.ViewHolder onCreateViewHolder (ViewGroup parent, int type) {
+      Context context = parent.getContext(); LinearLayout wrap = column(context);
+      if (type == 0) {
+        wrap.setGravity(Gravity.CENTER);
+        wrap.addView(label(context, "★", 64, 0xffffc148));
+        wrap.addView(label(context, Lang.getString(R.string.SviriStarsBalance), 15, Theme.getColor(ColorId.textLight)));
+        wrap.addView(label(context, "", 34, Theme.getColor(ColorId.text)));
+        TextView refresh = label(context, Lang.getString(R.string.SviriRefresh), 15, Theme.getColor(ColorId.textLink));
+        refresh.setOnClickListener(view -> reset(filter)); wrap.addView(refresh);
+      } else if (type == 1) {
+        LinearLayout tabs = new LinearLayout(context); tabs.setGravity(Gravity.CENTER);
+        int[] labels = {R.string.SviriAllTransactions, R.string.SviriIncoming, R.string.SviriOutgoing};
+        for (int i = 0; i < 3; i++) {
+          final int choice = i;
+          TextView tab = label(context, Lang.getString(labels[i]), 14, Theme.getColor(ColorId.text)); tab.setGravity(Gravity.CENTER);
+          tab.setOnClickListener(view -> { if (filter != choice) reset(choice); });
+          tabs.addView(tab, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
+        }
+        wrap.addView(tabs);
+      } else {
+        wrap.addView(label(context, "", 16, Theme.getColor(ColorId.text)));
+        if (type == 2) {
+          wrap.addView(label(context, "", 13, Theme.getColor(ColorId.textLight)));
+          wrap.addView(label(context, "", 19, Theme.getColor(ColorId.textLink)));
+        }
+      }
+      return new RecyclerView.ViewHolder(wrap) {};
+    }
+    @Override public void onBindViewHolder (RecyclerView.ViewHolder holder, int position) {
+      LinearLayout wrap = (LinearLayout) holder.itemView; int type = getItemViewType(position);
+      GradientDrawable background = new GradientDrawable(); background.setColor(Theme.getColor(ColorId.filling)); background.setCornerRadius(Screen.dp(22)); wrap.setBackground(background);
+      if (type == 0) {
+        TdApi.StarAmount value = tdlib.ownedStarAmount();
+        ((TextView) wrap.getChildAt(2)).setText(value != null ? amount(value) : loading ? "…" : Lang.getString(R.string.SviriBalanceUnavailable));
+      } else if (type == 1) {
+        LinearLayout tabs = (LinearLayout) wrap.getChildAt(0);
+        for (int i = 0; i < 3; i++) {
+          TextView tab = (TextView) tabs.getChildAt(i); tab.setTextColor(Theme.getColor(i == filter ? ColorId.textLink : ColorId.textLight));
+          GradientDrawable selected = new GradientDrawable(); selected.setColor(i == filter ? 0x22339fed : 0x00000000); selected.setCornerRadius(Screen.dp(22)); tab.setBackground(selected);
+        }
+      } else if (type == 2) {
+        TdApi.StarTransaction transaction = entries.get(position - 2);
+        ((TextView) wrap.getChildAt(0)).setText(title(transaction) + (transaction.isRefund ? " · " + Lang.getString(R.string.SviriRefund) : ""));
+        ((TextView) wrap.getChildAt(1)).setText(DateFormat.getDateTimeInstance(DateFormat.SHORT, DateFormat.SHORT).format(new Date(transaction.date * 1000L)));
+        String value = amount(transaction.starAmount);
+        TextView sum = (TextView) wrap.getChildAt(2); sum.setText((value.startsWith("-") ? "" : "+") + value + " ★");
+        sum.setTextColor(value.startsWith("-") ? 0xfff17c7c : 0xff72cda4);
+      } else {
+        ((TextView) wrap.getChildAt(0)).setText(loading ? Lang.getString(R.string.LoadingInformation) : error != null ? error + "\n" + Lang.getString(R.string.SviriRetry) : !offset.isEmpty() ? Lang.getString(R.string.SviriLoadMore) : entries.isEmpty() ? Lang.getString(R.string.SviriNoStarTransactions) : Lang.getString(R.string.SviriRefresh));
+        wrap.setOnClickListener(view -> { if (loading) return; if (error != null || !offset.isEmpty()) load(); else reset(filter); });
+      }
+    }
+  }
+  @Override public void destroy () { generation++; tdlib.removeStarAmountListener(balanceListener); super.destroy(); }
+}
