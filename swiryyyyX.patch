+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+import org.drinkless.tdlib.TdApi;
+/** Uses Telegram entities, not substring matches or promotional keywords. */
+public final class MentionInboxPolicy {
+  public static int authorType(TdApi.MessageSender sender,TdApi.User user) {
+    if(!(sender instanceof TdApi.MessageSenderUser))return 3;
+    return user==null?0:user.type instanceof TdApi.UserTypeRegular?1:2;
+  }
+  public static int relation(TdApi.Message message,TdApi.FormattedText text,long me,String[] usernames) {
+    return message.replyTo instanceof TdApi.MessageReplyToMessage ? 2 : 0;
+  }
+  public static boolean repliedToMe(TdApi.Message original,long me) {
+    return original!=null&&original.senderId instanceof TdApi.MessageSenderUser&&((TdApi.MessageSenderUser)original.senderId).userId==me;
+  }
+  public static boolean humanPersonal(MentionInboxStore.Entry e){return e.senderUserId>0&&e.authorType==1&&e.relation==3&&!e.viaBot;}
+}
diff --git a/app/src/main/java/org/thunderdog/challegram/telegram/MentionInboxStore.java b/app/src/main/java/org/thunderdog/challegram/telegram/MentionInboxStore.java
new file mode 100644
index 00000000..4f971167
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/telegram/MentionInboxStore.java
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+package org.thunderdog.challegram.telegram;
+
+import java.io.*;
+import java.util.*;
+
+/** Bounded, account-owned local history. Viewing the inbox does not read Telegram messages. */
+public final class MentionInboxStore {
+  public interface Storage { byte[] read(); void write(byte[] value); }
+  public static final int LIMIT = 500;
+  public static final class Entry {
+    public final long chatId, messageId;
+    public final int date, authorType, relation;
+    public final long senderUserId;
+    public final boolean viaBot;
+    public final String chat, sender, text;
+    public final boolean seen;
+    public Entry(long chatId, long messageId, int date, String chat, String sender, String text, boolean seen) {
+      this(chatId,messageId,date,chat,sender,text,seen,0,0,0,false);
+    }
+    public Entry(long chatId,long messageId,int date,String chat,String sender,String text,boolean seen,long senderUserId,int authorType,int relation,boolean viaBot) {
+      this.senderUserId=senderUserId;this.authorType=authorType;this.relation=relation;this.viaBot=viaBot;
+      this.chatId=chatId; this.messageId=messageId; this.date=date;
+      this.chat=clip(chat,160); this.sender=clip(sender,160); this.text=clip(text,1200); this.seen=seen;
+    }
+  }
+  private final java.util.concurrent.CopyOnWriteArrayList<Runnable> listeners=new java.util.concurrent.CopyOnWriteArrayList<>();
+  public void addListener(Runnable listener){listeners.addIfAbsent(listener);}
+  public void removeListener(Runnable listener){listeners.remove(listener);}
+  private final Storage storage;
+  private final long userId;
+  private List<Entry> entries = new ArrayList<>();
+  private static String clip(String s,int limit) { return s==null?"":s.length()>limit?s.substring(0,limit):s; }
+  private static final Comparator<Entry> ORDER = Comparator.comparingInt((Entry e)->e.date).reversed()
+    .thenComparing(Comparator.comparingLong((Entry e)->e.messageId).reversed()).thenComparingLong(e->e.chatId);
+  public MentionInboxStore(long userId, Storage storage) {
+    this.userId=userId; this.storage=storage;
+    byte[] data; try { data=storage.read(); } catch(RuntimeException ignored) { return; }
+    if(data==null||data.length>4_000_000)return;
+    try(DataInputStream in=new DataInputStream(new ByteArrayInputStream(data))) {
+      int version=in.readInt();if((version!=1&&version!=2)||in.readLong()!=userId)return;
+      int count=in.readInt(); if(count<0||count>LIMIT)return;
+      List<Entry> loaded=new ArrayList<>();
+      for(int i=0;i<count;i++) {
+        Entry e=new Entry(in.readLong(),in.readLong(),in.readInt(),in.readUTF(),in.readUTF(),in.readUTF(),in.readBoolean());
+        if(version==2)e=new Entry(e.chatId,e.messageId,e.date,e.chat,e.sender,e.text,e.seen,in.readLong(),in.readInt(),in.readInt(),in.readBoolean());
+        loaded.add(e);
+      }
+      loaded.sort(ORDER); entries=loaded;
+    }catch(IOException|RuntimeException ignored) { entries=new ArrayList<>(); }
+  }
+  public synchronized List<Entry> snapshot() { return new ArrayList<>(entries); }
+  public synchronized boolean contains(long chatId,long messageId) { return find(entries,chatId,messageId)>=0; }
+  private static int find(List<Entry> values,long c,long m) { for(int i=0;i<values.size();i++)if(values.get(i).chatId==c&&values.get(i).messageId==m)return i;return -1; }
+  public synchronized void put(Entry entry) { putAll(Collections.singletonList(entry)); }
+  public synchronized void putAll(List<Entry> additions) {
+    if(userId<=0 || additions.isEmpty())return;
+    List<Entry> next=new ArrayList<>(entries);
+    for(Entry entry:additions) {
+      if(entry==null || entry.chatId==0 || entry.messageId==0)continue;
+      int i=find(next,entry.chatId,entry.messageId);
+      if(i>=0){Entry old=next.remove(i);entry=new Entry(entry.chatId,entry.messageId,entry.date,entry.chat,entry.sender,entry.text,old.seen,entry.senderUserId,entry.authorType,entry.relation,entry.viaBot);}
+      next.add(entry);
+    }
+    next.sort(ORDER); if(next.size()>LIMIT)next=new ArrayList<>(next.subList(0,LIMIT)); save(next);
+  }
+  public synchronized void seen(long c,long m) {
+    int i=find(entries,c,m);if(i<0||entries.get(i).seen)return;
+    List<Entry> next=new ArrayList<>(entries);Entry e=next.get(i);next.set(i,new Entry(c,m,e.date,e.chat,e.sender,e.text,true,e.senderUserId,e.authorType,e.relation,e.viaBot));save(next);
+  }
+  public synchronized void edit(long c,long m,String text) {
+    int i=find(entries,c,m);if(i<0)return;Entry e=entries.get(i);put(new Entry(c,m,e.date,e.chat,e.sender,text,e.seen,e.senderUserId,e.authorType,e.relation,e.viaBot));
+  }
