--- /dev/null
+++ b/build-swiryyyyX.ps1
@@ -0,0 +1,22 @@
+$ErrorActionPreference = 'Stop'
+Set-Location $PSScriptRoot
+if (!(Test-Path 'local.properties')) {
+  Copy-Item 'local.properties.swiryyyyX.example' 'local.properties'
+  throw 'Fill sdk.dir, msys2.dir, telegram.api_id and telegram.api_hash in local.properties, then run again.'
+}
+$properties = Get-Content 'local.properties' -Raw
+foreach ($key in @('sdk.dir', 'msys2.dir', 'telegram.api_id', 'telegram.api_hash')) {
+  $escaped = [regex]::Escape($key)
+  if ($properties -notmatch "(?m)^$escaped\s*=\s*\S+") {
+    throw "Missing $key in local.properties"
+  }
+}
+$javaVersion = & java -version 2>&1 | Out-String
+if ($LASTEXITCODE -ne 0 -or $javaVersion -notmatch 'version "25[.\"]') {
+  throw 'Use JDK 25 in PATH and JAVA_HOME before building this Telegram X revision.'
+}
+& git submodule update --init --recursive
+if ($LASTEXITCODE -ne 0) { throw 'Could not prepare source submodules.' }
+& .\gradlew.bat assembleLatestUniversalDebug
+if ($LASTEXITCODE -ne 0) { throw 'APK build failed; inspect the Gradle error above.' }
+Get-ChildItem 'app/build/outputs/apk' -Recurse -Filter '*.apk' | Select-Object FullName, Length
