+    UI.post(timeout,20000L);
+    TdApi.SearchChatMessages search=new TdApi.SearchChatMessages();search.chatId=chatId;search.query="";search.limit=20;search.filter=new TdApi.SearchMessagesFilterUnreadMention();
+    tdlib.client().send(search,result->{
+      UI.post(()->{
+        UI.removePendingRunnable(timeout);if(!current()||token!=generation)return;requesting=false;
+        if(result instanceof TdApi.FoundChatMessages) {
