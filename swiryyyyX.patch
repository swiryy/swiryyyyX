+  private int priorityWarmupGeneration;
+
+  private void rememberPriorityChat (TdApi.Chat chat) {
+    if (chat == null) return;
+    boolean direct = false, channel = false;
+    int members = 0;
+    switch (chat.type.getConstructor()) {
+      case TdApi.ChatTypePrivate.CONSTRUCTOR:
+      case TdApi.ChatTypeSecret.CONSTRUCTOR:
+        direct = true;
+        break;
+      case TdApi.ChatTypeBasicGroup.CONSTRUCTOR: {
+        TdApi.BasicGroup group = cache().basicGroup(((TdApi.ChatTypeBasicGroup) chat.type).basicGroupId);
+        members = group != null ? group.memberCount : 0;
+        break;
+      }
+      case TdApi.ChatTypeSupergroup.CONSTRUCTOR: {
+        TdApi.ChatTypeSupergroup type = (TdApi.ChatTypeSupergroup) chat.type;
+        channel = type.isChannel;
+        TdApi.Supergroup group = cache().supergroup(type.supergroupId);
+        members = group != null ? group.memberCount : 0;
+        if (members == 0 && !channel) {
+          TdApi.SupergroupFullInfo full = cache().supergroupFull(type.supergroupId, false);
+          if (full != null) members = full.memberCount;
+        }
+        break;
+      }
+    }
+    settings().rememberPriorityChat(chat.id, PriorityChatPolicy.eager(direct, channel, members));
+  }
+
+  private void restorePriorityChats (long[] ids, int offset, int generation) {
+    if (generation != priorityWarmupGeneration || !isAuthorized() || offset >= ids.length) return;
+    int end = Math.min(offset + 16, ids.length);
+    java.util.concurrent.atomic.AtomicInteger remaining = new java.util.concurrent.atomic.AtomicInteger(end - offset);
